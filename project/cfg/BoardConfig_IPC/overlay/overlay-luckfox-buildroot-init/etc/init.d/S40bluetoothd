#!/bin/sh
# BlueZ daemon — after S35wifibt brings up hci0.

DAEMON="bluetoothd"
PIDFILE="/var/run/$DAEMON.pid"
BLUETOOTHD="/usr/libexec/bluetooth/$DAEMON"
BLUETOOTHD_ARGS="-n --experimental"

[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

wait_hci0() {
	i=0
	while [ "$i" -lt 20 ]; do
		hciconfig hci0 >/dev/null 2>&1 && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

start() {
	if [ ! -x "$BLUETOOTHD" ]; then
		echo "bluetoothd: not installed"
		return 1
	fi
	if ! pgrep -x dbus-daemon >/dev/null 2>&1; then
		echo "bluetoothd: dbus not running, start S30dbus first"
		return 1
	fi
	if ! wait_hci0; then
		echo "bluetoothd: hci0 not ready"
		return 1
	fi

	printf 'Starting %s: ' "$DAEMON"
	start-stop-daemon -S -q -m -b -p "$PIDFILE" -x "$BLUETOOTHD" -- $BLUETOOTHD_ARGS
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
	killall "$DAEMON" 2>/dev/null
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start|stop|restart) "$1" ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
