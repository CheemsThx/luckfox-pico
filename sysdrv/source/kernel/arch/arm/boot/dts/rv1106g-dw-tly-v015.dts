/*
 * 东威 DW-TLY-V015 — 8-bit eMMC + AIC8800
 * WiFi/BT 模组兼容 AIC8800DC 与 AIC8800D80/D80L（同一 SDIO + UART1 脚位）
 * WiFi SDIO: GPIO3 sdmmc0 / &sdmmc（与官方 Ultra 相同）
 * GPIO2 sdmmc1m0 / &sdio 为 SD 卡，勿用于 WiFi
 */

/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-luckfox-pico-ultra-ipc.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>

/ {
	model = "Dongwei DW-TLY-V015 eMMC";
	compatible = "dongwei,dw-tly-v015", "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	/* WL_EN: ACTIVE_LOW 复位低有效；低保持 100ms 再拉高，再等 500ms 扫 SDIO */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		pre-power-on-delay-ms = <100>;
		post-power-on-delay-ms = <500>;
	};

	/* WL_HOST_WAKE → GPIO3_B1 */
	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		WIFI,host_wake_irq = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart1m0_rtsn>;
		pinctrl-1 = <&uart1_gpios>;
		/* BT_WAKE_HOST → GPIO3_B0 */
		BT,wake_gpio     = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		/* HOST_WAKE_BT → GPIO0_A2 */
		BT,wake_host_irq = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/**********V015: KLM8G1GETF-B041 eMMC；U17 VCCQ/焊球映射待硬件签核，禁止直接烧录**********/
&sfc {
	status = "disabled";
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	no-sdio;
	no-sd;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_3v3>;
	memory-region-ecsd = <&mmc_ecsd>;
	rockchip,default-sample-phase = <90>;
	post-power-on-delay-ms = <0>;
	status = "okay";
};

&fiq_debugger {
	rockchip,irq-mode-enable = <1>;
	status = "okay";
};

/********* CPU 动态调频/调压：本板不需要，整体撤销（无软件控制路径）*********
 * 硬件事实（V015 网表 2026-09-29，设计证据）：U2 CPU_DVDD(pin115) 与 DVDD/PMU 同接
 * VDD_0V9；该轨由 U57 SY8088IAAC 经 L18 产生，FB 分压 R316=100k（VDD_0V9→FB）/
 * R315=200k（FB→GND），网表中不存在从 SoC 到 U57 的 PWM/I2C 调压连接。即 CPU 电压
 * 不可调、也不应随频率变化。**该电压按网表分压比推导，未做上板实测。**
 *
 * 撤销项与理由（与 V020 板 rv1106-dw-tly-v020-ipc.dtsi 的做法一致；本版是对此前
 * “只删 cpu-supply”的纠正：需求是本板不要 CPU 动态调频，而不是在固定轨上继续
 * 保留调频能力）：
 *   1) cpu0 的 operating-points-v2：rv1106.dtsi 的 cpu0-opp-table 是按可调 rail
 *      设计的。本板固定 0.9V，而表中 408M~1296M 额定 850~875mV（低于 0.9V），
 *      仅 1416M/1512M/1608M 额定 925/975/1000mV（高于 0.9V）——即整表并非同一侧，
 *      高频档要求高于本板固定轨、低频档低于它。保留绑定就意味着 cpufreq/OPP 仍按
 *      “可调压换档”模型工作：一旦有任何路径触发 set_rate，要求电压高于 0.9V 的档位
 *      对固定轨的 set_voltage 必然失败（另外低频档会请求低于 0.9V 的电压，对固定轨
 *      同样不可实现）。本板不做 DVFS，直接去掉绑定。
 *   2) cpu0 的 cpu-supply：去掉后 drivers/cpufreq/rockchip-cpufreq.c 的
 *      rockchip_cpufreq_cluster_init() 在 `of_find_property(dev->of_node,
 *      "cpu-supply", NULL)` 处返回 -ENOENT（同函数对 cpu0-supply 的 else-if 也
 *      不命中），rockchip_cpufreq_driver_init() 随即放弃注册 cpufreq-dt；同时
 *      cpufreq-dt.c 的 find_supply_name() 返回 NULL，不再 dev_pm_opp_set_regulators()。
 *   3) 本板继承的 vdd_arm 虚拟 fixed regulator 与 cpu0-opp-table 节点：对固定硬件
 *      轨没有软件控制意义，一并删除。
 *
 * 内核配置层面同时收口：rv1106-v015.config 关掉 CONFIG_CPU_FREQ，进而由
 * olddefconfig 置 n CPUFREQ_DT / ARM_ROCKCHIP_CPUFREQ / 各 governor /
 * CPU_FREQ_THERMAL（见该文件注释）。这样即使 DTS 日后被误改，内核里也没有
 * cpufreq 子系统从 cpufreq 路径调压/调频。（本次只论证到 cpufreq 子系统不在内核
 * 这一层；其它时钟驱动路径是否会改 CPU 时钟不在本证据范围内。）
 *
 * 频率：本板不指定任何运行频率。撤销 cpufreq 后内核不再有 cpufreq 侧
 * clk_set_rate(ARMCLK) 换档通路；ARMCLK 的静态运行值来自内核 clk 框架在 cru
 * provider 初始化时应用的通用 rv1106.dtsi cru 节点 assigned-clock-rates
 * ARMCLK=1104000000（clk-rv1106.c CLK_OF_DECLARE → drivers/clk/clk.c of_clk_init
 * 调 of_clk_set_defaults，见 clk-conf.c）。因此**预期**运行 1.104GHz，须上板确认；
 * 它并非“bootloader 默认”。后续若实测 1.104GHz@0.9V 不稳，应在板级 DTS 覆盖
 * `&cru` 的 assigned-clock-rates 降频，而不是去改通用 rv1106.dtsi。
 *
 * 热保护保留，不受本改动影响：
 *   - tsadc 仍在（rv1106.dtsi tsadc@ff3c8000，rockchip,hw-tshut-temp=120℃、
 *     rockchip,hw-tshut-mode=0:CRU），超温直接硬件复位 SoC，与 cpufreq 无关；
 *   - soc-thermal 的 critical trip 仍在（115℃，见 rv1106.dtsi soc-crit），由
 *     thermal core 直接处理（orderly_poweroff + emergency poweroff），不经过
 *     cpufreq cooling（drivers/thermal/thermal_core.c handle_critical_trips）；
 *   - CONFIG_THERMAL / CONFIG_ROCKCHIP_THERMAL 未改。
 */
&cpu0 {
	/delete-property/ operating-points-v2;
	/delete-property/ cpu-supply;
};

/delete-node/ &vdd_arm;
/delete-node/ &cpu0_opp_table;

/**********SDIO-WIFI on GPIO3 sdmmc0（与官方 Ultra 一致）**********
 * CLK/CMD: GPIO3_A4/A5  D0-D3: GPIO3_A3/A2/A7/A6  DET: GPIO3_A1
 *
 * 注意：RV1106 的 GPIO3 IOC 有 force_jtag_sdmmc（0xff538000 + 0x202f4），上电即为 1，
 * 会把 SDMMC0 的 GPIO3_A1..A7 交给 JTAG，导致 4 位传输每个块报 SBE（1 位不受影响）。
 * V015 的 Wi-Fi SDIO 正好在这组脚/这个控制器上，因此本板必须靠内核 grf.c 的
 * "rockchip,rv1106-ioc" 条目在 postcore_initcall 阶段清掉该位；配套要求内核开启
 * CONFIG_ROCKCHIP_GRF（见 arch/arm/configs/rv1106-v015.config）。
 * 该根因在 DW-TLY-V020 实板实测确认；V015 尚无实板，上板后请 devmem 读 0xff5582f4 复核。
 */
&sdmmc {
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	rockchip,default-sample-phase = <90>;
	supports-sdio;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";
};

/**********SD 卡 TF（GPIO2 sdmmc1m0 / &sdio，与原理图一致）**********
 * D0-D3: GPIO2_A1/A0/A5/A4  CLK: GPIO2_A2  CMD: GPIO2_A3
 */
&sdio {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	supports-sd;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_cmd &sdmmc1m0_clk &sdmmc1m0_bus4>;
	status = "okay";
};

/**********CSI 2-lane（GPIO3_B0/B1 留给 WiFi/BT 唤醒，不用 mipi_pins 的 d3）**********
 * 官方 Ultra dtsi 默认 okay；此前为避让唤醒脚整段关掉。
 * 传感器 data-lanes = <1 2>，只需 ck0+d0+d1。勿开 dphy1/mipi1/vir1，勿重开 LCD。
 * i2c4 保持 dtsi 的 i2c4m2（GPIO3_PC7/PD0），勿改 m0（与 SD GPIO2 冲突）。
 */
&csi2_dphy0 {
	status = "okay";
};

&mipi0_csi2 {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mipi_pins_2lane>;
};

&rkcif_mipi_lvds_sditf {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

/**********自研板无 LCD/触摸：释放 GPIO2 给 SD 卡 **********
 * Ultra dtsi 的 RGB 使用 lcd_d8~d13 = GPIO2_A0~A5，与 sdmmc1m0 冲突
 */
/ {
	panel: panel {
		status = "disabled";
	};

	backlight: backlight {
		status = "disabled";
	};
};

&display_subsystem {
	status = "disabled";
};

&rgb {
	status = "disabled";
};

&rgb_in_vop {
	status = "disabled";
};

&route_rgb {
	status = "disabled";
};

&vop {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&i2c3 {
	status = "disabled";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********RTC**********/
&rtc {
	status = "okay";
};

/**********BT**********/
&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn>;
};

/**********ESP32-C3（U5）UART3 M0：GPIO1_A0 TX / GPIO1_A1 RX**********
 * 覆盖 ipc dtsi 的 <&uart3m0_xfer &uart3m1_xfer>。uart3m1 是 GPIO1_D0/D1，本板不用。
 * U5 ESP_RX/ESP_TX 只接调试座，不是和 1106 通讯的那对。
 * 别名 serial3（rv1106.dtsi）→ /dev/ttyS3。勿改 &uart1（AIC HCI / ttyS1）。
 */
&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m0_xfer>;
};

&pinctrl {
	sdmmc0 {
		sdmmc0_det: sdmmc0-det {
			rockchip,pins = <3 RK_PA1 1 &pcfg_pull_down>;
		};
	};

	wireless-bluetooth {
		uart1_gpios: uart1-gpios {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	mipi {
		mipi_pins_2lane: mipi-pins-2lane {
			rockchip,pins =
				<3 RK_PC0 2 &pcfg_pull_none>,
				<3 RK_PC1 2 &pcfg_pull_none>,
				<3 RK_PC2 2 &pcfg_pull_none>,
				<3 RK_PC3 2 &pcfg_pull_none>,
				<3 RK_PB6 2 &pcfg_pull_none>,
				<3 RK_PB7 2 &pcfg_pull_none>;
		};
	};
};

/********** ram oops / pstore（DW-SDK-003）**********
 * 沿用 V014 的 256MB DRAM 布局假设；V015 实际容量须由 DDR 配置及实板验证。
 * 禁止复制 rv1106-thunder-boot.dtsi 的 ramoops@0x7c000 / 0x3000：那是 128MB thunder-boot
 * 板上 MCU log（record/console 均为 0），不是内核 console，且 0x7c000 落在本板
 * SPL BSS/栈 0x001fe000 与 U-Boot TEXT 0x00200000 之前，会被下次启动冲掉。
 *
 * U-Boot ENV_MEM_LAYOUT（rv1106_common.h，非 CONFIG_ENV_MEM_LAYOUT 时）：
 *   Image   0–8MB     kernel_addr_r=0x00008000；内核 TEXT_OFFSET=0x00208000
 *   zImage  8–12MB    kernel_addr_c=0x00808000
 *   fdt    12–13MB    fdt_addr_r=0x00c00000（本板 dtb ≪ 1MB）
 *   （空隙 13–14MB） ← ramoops 放这里
 *   ramdisk 14MB+     ramdisk_addr_r=0x00e00000；CONFIG_SYS_LOAD_ADDR=0x00e00800
 * SPL TEXT 0x0、BSS/栈 0x001fe000；U-Boot TEXT 0x00200000、INIT_SP 0x00400000。
 * dtsi reserved-memory：mmc_ecsd@0x3f000 size 4K；drm-logo@0 size 0（占位）。
 * CMA：bootargs rk_dma_heap_cma=66M，且 DT linux,cma 10M reusable+inactive，均无
 * 固定基址，arm_memblock_init 里 dma_contiguous_reserve 与 rk_dma_heap_cma_setup
 * 从 DRAM 高端切，远离 13MB。ramoops 256KB 不占 CMA。
 * 不设 no-map：ramoops 需要内核映射。
 */
&reserved_memory {
	ramoops@d00000 {
		compatible = "ramoops";
		reg = <0x00d00000 0x00040000>; /* 13MB，256KB */
		record-size = <0x8000>;        /* 32KB × 约 4 条 oops/panic */
		console-size = <0x20000>;      /* 128KB printk，watchdog 硬复位也能留尾 */
		ftrace-size = <0x0>;
		pmsg-size = <0x0>;
	};
};

/**********SPI**********/
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
};
