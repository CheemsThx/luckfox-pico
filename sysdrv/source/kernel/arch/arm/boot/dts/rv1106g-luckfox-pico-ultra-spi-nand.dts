/*
 * Luckfox Pico Ultra W 自研板 — SPI NAND + AIC8800
 * WiFi SDIO: GPIO3 sdmmc0 / &sdmmc（与官方 Ultra 相同）
 * GPIO2 sdmmc1m0 / &sdio 为 SD 卡，勿用于 WiFi
 */

/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-luckfox-pico-ultra-ipc.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>

/ {
	model = "Luckfox Pico Ultra W Custom";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	/* WL_EN: ACTIVE_LOW 复位低有效；低保持 100ms 再拉高，再等 500ms 扫 SDIO */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		pre-power-on-delay-ms = <100>;
		post-power-on-delay-ms = <500>;
	};

	/* WL_HOST_WAKE → GPIO3_B1 */
	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		WIFI,host_wake_irq = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart1m0_rtsn>;
		pinctrl-1 = <&uart1_gpios>;
		/* BT_WAKE_HOST → GPIO3_B0 */
		BT,wake_gpio     = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		/* HOST_WAKE_BT → GPIO0_A2 */
		BT,wake_host_irq = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/**********SPI NAND (Winbond W25N02KVZEIR, 2Gbit/256MB)**********/
&sfc {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&fspi_pins &fspi_cs0>;

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&emmc {
	status = "disabled";
};

&fiq_debugger {
	rockchip,irq-mode-enable = <1>;
	status = "okay";
};

/**********SDIO-WIFI on GPIO3 sdmmc0（与官方 Ultra 一致）**********
 * CLK/CMD: GPIO3_A4/A5  D0-D3: GPIO3_A3/A2/A7/A6  DET: GPIO3_A1
 */
&sdmmc {
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	rockchip,default-sample-phase = <90>;
	supports-sdio;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";
};

/**********SD 卡 TF（GPIO2 sdmmc1m0 / &sdio，与原理图一致）**********
 * D0-D3: GPIO2_A1/A0/A5/A4  CLK: GPIO2_A2  CMD: GPIO2_A3
 */
&sdio {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	supports-sd;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_cmd &sdmmc1m0_clk &sdmmc1m0_bus4>;
	status = "okay";
};

// 自研板: GPIO3_B0/B1 给 WiFi/BT 唤醒，禁用 MIPI 摄像头
&csi2_dphy0 {
	status = "disabled";
};

&mipi0_csi2 {
	status = "disabled";
};

&rkcif_mipi_lvds {
	status = "disabled";
};

&rkcif_mipi_lvds_sditf {
	status = "disabled";
};

&rkisp_vir0 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

/**********自研板无 LCD/触摸：释放 GPIO2 给 SD 卡 **********
 * Ultra dtsi 的 RGB 使用 lcd_d8~d13 = GPIO2_A0~A5，与 sdmmc1m0 冲突
 */
/ {
	panel: panel {
		status = "disabled";
	};

	backlight: backlight {
		status = "disabled";
	};
};

&display_subsystem {
	status = "disabled";
};

&rgb {
	status = "disabled";
};

&rgb_in_vop {
	status = "disabled";
};

&route_rgb {
	status = "disabled";
};

&vop {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&i2c3 {
	status = "disabled";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********RTC**********/
&rtc {
	status = "okay";
};

/**********BT**********/
&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn>;
};

&pinctrl {
	sdmmc0 {
		sdmmc0_det: sdmmc0-det {
			rockchip,pins = <3 RK_PA1 1 &pcfg_pull_down>;
		};
	};

	wireless-bluetooth {
		uart1_gpios: uart1-gpios {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/**********SPI**********/
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
};
