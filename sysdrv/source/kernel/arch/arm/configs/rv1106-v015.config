# DW-TLY-V015 板级增量内核配置
#
# 由 BoardConfig-EMMC-Buildroot-RV1106_DW_TLY_V015-IPC.mk 的
# RK_KERNEL_DEFCONFIG_FRAGMENT 在 luckfox_rv1106_linux_defconfig 之上叠加。
# 目前只放 V015 相对基座真正多出来的一项，不做无关改动。

# Rockchip GRF 初始化 —— V015 的 4 位 Wi-Fi SDIO 能不能用，取决于这一行。
#
# drivers/soc/rockchip/grf.c 里为 RV1106 加了一条写 GPIO3 IOC 0x202f4 的默认值
# （清掉 force_jtag_sdmmc），理由见该文件 rv1106_ioc_defaults 上方注释。
# 但 grf.c 的编译条件是 `obj-$(CONFIG_ROCKCHIP_GRF) += grf.o`，而
# luckfox_rv1106_linux_defconfig 没有开这个符号（只有 RV1126 的板级会开），
# 不开这一行那段代码根本不参与编译，Wi-Fi SDIO 会退回“4 位块读全 SBE”的老样子。
#
# 取 =y 而非 =m：rockchip_grf_init() 是 postcore_initcall，必须早于 mmc 控制器
# probe（device_initcall）才有意义；做成模块会在 probe 之后才加载，等于没修。
CONFIG_ROCKCHIP_GRF=y

# ---- CPU 动态调频/调压：本板不需要，整体关闭 ----
#
# 基座 luckfox_rv1106_linux_defconfig 开了 CONFIG_CPU_FREQ=y / CPUFREQ_DT=y /
# ARM_ROCKCHIP_CPUFREQ=y，后者 module_init(rockchip_cpufreq_driver_init) 会为每个
# CPU 建 cluster 并注册 cpufreq-dt。V015 的 CPU 电源由 U57 SY8088IAAC + R315/R316
# 硬件固定 0.9V，网表上没有 SoC 到 U57 的 PWM/I2C 控制路径，CPU 既不可调压、也不需要
# 调频。板级 DTS 已删除 cpu0 的 operating-points-v2/cpu-supply 与 vdd_arm、
# cpu0-opp-table 节点（见 rv1106g-dw-tly-v015.dts）；这里在内核配置层面再收口：
# 不编译 cpufreq 子系统，从而没有任何 cpufreq 路径去调 CPU 时钟或向 regulator 请求
# 电压；此处只论证 cpufreq 子系统不在内核，其它时钟驱动路径不在本证据范围内。
#
# 关掉 CPU_FREQ 后，依赖它的 CPUFREQ_DT / ARM_ROCKCHIP_CPUFREQ / 各 governor /
# CPU_FREQ_THERMAL（drivers/thermal/Kconfig 里在 `if CPU_THERMAL` 内且
# `depends on CPU_FREQ`，default y）由 olddefconfig 自动置 n。下面三行显式写出，
# 便于核对，也使意图明确。
#
# 热保护不受影响，刻意保留：
#   - CONFIG_THERMAL / CONFIG_ROCKCHIP_THERMAL 不依赖 CPU_FREQ，保持 =y；
#   - tsadc 的硬件 tshut（120℃，CRU 复位）与 soc-thermal 的 critical trip
#     （115℃）都在 DTS 里保留，critical 由 thermal core 直接 orderly_poweroff，
#     不经过 cpufreq cooling，详见板级 dts 内注释；
#   - CONFIG_CPU_THERMAL 只影响"用 CPU 当 cooling device"，没有 cpufreq policy
#     时本就无意义，保留 =y 无害。
#
# 频率：关掉后内核不再有 cpufreq 侧 clk_set_rate(ARMCLK) 换档通路，本 fragment
# 也不指定新频点；ARMCLK 运行值来自通用 rv1106.dtsi cru 节点
# assigned-clock-rates=1104000000（clk 框架 of_clk_set_defaults 在 cru provider
# 初始化时应用，见 drivers/clk/clk-conf.c），预期 1.104GHz，须上板确认。
# CONFIG_CPU_FREQ is not set
# CONFIG_CPUFREQ_DT is not set
# CONFIG_ARM_ROCKCHIP_CPUFREQ is not set
