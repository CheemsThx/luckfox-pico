# DW-TLY-V020 板级增量内核配置
#
# 由 BoardConfig-SPI_NAND-Buildroot-RV1106_DW-TLY-V020-IPC.mk 的
# RK_KERNEL_DEFCONFIG_FRAGMENT 在 luckfox_rv1106_linux_defconfig 之上叠加。
# 只放 V020 相对 V014 真正多出来的东西，不做无关改动。

# U7 CW2015CHBD 电量计（I2C0，地址待实测，DTS 里为 0x62）。
# 驱动已在本内核树内 drivers/power/supply/cw2015_battery.c，但默认未启用。
# Kconfig 依赖 I2C（本 defconfig 已 =y），并 select REGMAP_I2C。
#
# 取 =y 而非 =m：这颗驱动没有独立打包需求，内建可省掉 .ko 落地到 rootfs 的
# 安装路径依赖，bring-up 阶段少一个变量。
CONFIG_BATTERY_CW2015=y

# U3 BQ25601RTWR 充电管理（I2C0，0x6b）。
# 驱动由 Linux v5.12 回移进本内核树 drivers/power/supply/bq256xx_charger.c，
# 默认未启用。Kconfig 依赖 I2C 与 GPIOLIB（本 defconfig 均已 =y），
# 并 select REGMAP_I2C。
#
# 这颗驱动同时决定了 CW2015 那条 "Failed to get supply state: -19" 的消失：
# DTS 里 cw2015 节点加 power-supplies = <&bq25601> 后，本驱动的 charger
# power_supply 成为它的上游，power_supply_am_i_supplied() 才有东西可问。
# 所以它与 CONFIG_BATTERY_CW2015 必须同时启用，缺一个就退回 -19。
#
# 同样取 =y 而非 =m，理由同 CW2015。
#
# !! 临时关闭 —— 2026-09-23 boot-loop A/B 实验 !!
# [2026-09-23 A/B 已结案，恢复] 板子自 03:24 那版起反复硬复位，曾怀疑与"驱动上电后
# 改写 REG00..REG06"有关，故 A/B 版**不编入**充电驱动、让 BQ25601 回到 POR 默认值，
# 以便把两种可能分开（循环消失=驱动的寄存器写入；循环照旧=驱动无罪）。
# 实测结论：**去掉驱动后循环照旧** → 驱动的寄存器写入无罪，嫌疑人只剩硬件侧
# （QON/BATFET 复位通路、供电）。按此处原定规则恢复本行。
#
# 配套：DTS 里 cw2015 的 power-supplies **必须同步恢复**，否则
# power_supply_check_supplies() 会让 cw2015 永远 -EPROBE_DEFER、电量计直接消失。
CONFIG_CHARGER_BQ256XX=y

# 刻意不加 CONFIG_LEDS_PWM：
# 本板 PWM3(激光)/PWM4(补光) 的默认安全策略是「控制器 enabled 但无 consumer，
# 只有用户态显式 enable 才出波形」，这是靠 DTS 不配 consumer 实现的，
# 不需要 leds-pwm。用户态通路走 /sys/class/pwm，
# 而 CONFIG_PWM_SYSFS 在 luckfox_rv1106_linux_defconfig 里已经是 y。

# Rockchip GRF 初始化 —— 本板 SD 4 位读能不能用，**取决于这一行**。
#
# drivers/soc/rockchip/grf.c 里为 RV1106 加了一条写 GPIO3 IOC 0x202f4 的
# 默认值（清掉 force_jtag_sdmmc），详见该文件里 rv1106_ioc_defaults 的注释。
# 但 grf.c 的编译条件是 `obj-$(CONFIG_ROCKCHIP_GRF) += grf.o`，而
# luckfox_rv1106_linux_defconfig **没有开** 这个符号（只有 RV1126 的板级会开），
# 所以不开这一行，那段代码根本不参与编译，SD 会退回"4 位块读全部 SBE"的老样子。
#
# 取 =y：rockchip_grf_init() 是 postcore_initcall，必须早于 mmc 控制器 probe
# （device_initcall）才有意义，做成模块会在 probe 之后才加载，等于没修。
CONFIG_ROCKCHIP_GRF=y

# ---- CPU 动态调频/调压：本板不需要，整体关闭 ----
#
# 基座 luckfox_rv1106_linux_defconfig 开了 CONFIG_CPU_FREQ=y / CPUFREQ_DT=y /
# ARM_ROCKCHIP_CPUFREQ=y，后者 module_init(rockchip_cpufreq_driver_init) 会无条件
# 为每个 CPU 建 cluster 并注册 cpufreq-dt。V020 的 CPU 电源由 U9(RY3430)+R26/R27
# 硬件固定 0.9V，网表上没有 CPU 侧 PWM/I2C 到 U9 的控制路径，CPU 既不可调压也不
# 需要调频。板级 DTS 已删除 cpu0 的 operating-points-v2/cpu-supply 与
# cpu0-opp-table 节点（见 rv1106-dw-tly-v020-ipc.dtsi）；这里在内核配置层面再
# 收口：不编译 cpufreq 子系统，任何路径都无法改 CPU 时钟或向 regulator 请求电压。
#
# 关掉 CPU_FREQ 后，依赖它的 CPUFREQ_DT / ARM_ROCKCHIP_CPUFREQ / 各 governor /
# CPU_FREQ_THERMAL（drivers/thermal/Kconfig 里在 `if CPU_THERMAL` 内且
# `depends on CPU_FREQ`，default y）由 olddefconfig 自动置 n。下面三行显式写出，
# 便于核对，也使意图明确。
#
# 热保护不受影响，刻意保留：
#   - CONFIG_THERMAL / CONFIG_ROCKCHIP_THERMAL 不依赖 CPU_FREQ，保持 =y；
#   - tsadc 的硬件 tshut（120℃，CRU 复位）与 soc-thermal 的 critical trip
#     （115℃）都在 DTS 里保留，critical 由 thermal core 直接 orderly_poweroff，
#     不经过 cpufreq cooling，详见板级 dtsi 内注释；
#   - CONFIG_CPU_THERMAL 只影响"用 CPU 当 cooling device"，没有 cpufreq policy
#     时本就无意义，保留 =y 无害。
#
# 频率：关掉后内核不再调用 clk_set_rate(ARMCLK)，CPU 保持 bootloader 默认
# （U-Boot APLL_HZ=1104MHz），未指定新的运行频率。
# CONFIG_CPU_FREQ is not set
# CONFIG_CPUFREQ_DT is not set
# CONFIG_ARM_ROCKCHIP_CPUFREQ is not set
